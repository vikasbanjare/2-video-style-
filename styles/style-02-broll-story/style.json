{
  "id": "style-02-broll-story",
  "name": "B-Roll Story",
  "description": "PLACEHOLDER until the reference sample is analysed. B-roll driven, no captions, client-supplied b-roll only.",
  "sequence": {
    "width": 1080,
    "height": 1920
  },
  "cuts": {
    "max_pause": 0.3,
    "pad_before": 0.06,
    "pad_after": 0.1,
    "min_clip": 0.35,
    "tail_after_last_word": 0.6,
    "fillers": [
      "um",
      "uh",
      "uhh",
      "umm",
      "erm",
      "er",
      "ah",
      "hmm"
    ],
    "remove_retakes": true
  },
  "hook": {
    "remove_from_body": true,
    "gap_after": 0.0,
    "caption_mode": "none"
  },
  "title_card": {
    "fade_in_start": 0.0,
    "fade_duration": 0.25,
    "end": "hook_end"
  },
  "captions": {
    "enabled": false
  },
  "music": {
    "enabled": true,
    "level_db": -20,
    "fade_in": 0.3,
    "fade_out": 1.0
  },
  "broll": {
    "enabled": true,
    "start_after": 1.5,
    "skip_hook": true,
    "end_before": 1.5,
    "min_len": 1.5,
    "max_len": 3.5,
    "min_gap": 2.0,
    "lead": 0.08,
    "max_coverage": 0.45,
    "_note": "defaults until reference sample is analysed"
  },
  "deliver": {
    "loudness_lufs": -14
  },
  "zoom": {
    "enabled": true,
    "levels": [
      100,
      112
    ],
    "min_hold": 2.5,
    "max_hold": 6.0,
    "change_on_cut": true,
    "skip_hook": false,
    "_note": "defaults until reference sample is analysed"
  }
}