{
  "id": "style-02-broll-story",
  "name": "B-Roll Story",
  "description": "Fast podcast clip: host-question hook with split-screen b-roll, guest name tag, punch-in re-cuts every ~1.5 s, b-roll on the spoken noun phrase (wide footage fitted over a blurred copy), count-up number graphics, 1-3 word captions with bold key phrases.",
  "sequence": {
    "width": 1080,
    "height": 1920
  },
  "cuts": {
    "max_pause": 0.25,
    "pad_before": 0.05,
    "pad_after": 0.08,
    "min_clip": 0.35,
    "tail_after_last_word": 0.5,
    "fillers": [
      "um",
      "uh",
      "uhh",
      "umm",
      "erm",
      "er",
      "ah",
      "hmm"
    ],
    "remove_retakes": true
  },
  "hook": {
    "remove_from_body": true,
    "gap_after": 0.0,
    "caption_mode": "chunk",
    "pick": "first"
  },
  "title_card": {
    "at": "after_hook",
    "duration": 1.5,
    "fade_in_start": 0.0,
    "fade_duration": 0.15,
    "end": "hook_end"
  },
  "captions": {
    "enabled": true,
    "prefer_client_srt": true,
    "reveal": "chunk",
    "chunk_max_words": 3,
    "chunk_max_chars": 18,
    "emphasis_share": 0.3,
    "emphasis_min_score": 2.0,
    "page_break_pause": 0.35,
    "hold_after_last_word": 0.2,
    "strip_punctuation": ".,!\";:",
    "cutoff_dash": "—",
    "censor": [
      "fuck",
      "fucking",
      "fucked",
      "shit",
      "bullshit",
      "bitch",
      "asshole",
      "motherfucker"
    ]
  },
  "caption_look": {
    "font": "SF Pro Display",
    "font_fallback": "Inter",
    "weight": "Medium",
    "size_px_at_1080w": 60,
    "tracking_px": -2,
    "color": "#FFFFFF",
    "stroke": null,
    "shadow": {
      "opacity": 0.25,
      "blur_px": 3,
      "distance_px": 1
    },
    "center_y_pct": 57
  },
  "caption_look_emphasis": {
    "font": "SF Pro Display",
    "font_fallback": "Inter",
    "weight": "Bold",
    "size_px_at_1080w": 93,
    "tracking_px": -3,
    "color": "#FFFFFF",
    "stroke": null,
    "shadow": {
      "opacity": 0.25,
      "blur_px": 3,
      "distance_px": 1
    },
    "center_y_pct": 57
  },
  "broll": {
    "enabled": true,
    "start_after": 0.8,
    "skip_hook": false,
    "hook_layout": "split",
    "fit_wide": true,
    "blur": 60,
    "end_before": 1.0,
    "min_len": 1.4,
    "max_len": 3.1,
    "min_gap": 1.5,
    "lookahead": 2.0,
    "lead": 0.05,
    "max_coverage": 0.42
  },
  "graphics": {
    "counters": true,
    "min_value": 1000,
    "min_len": 1.8,
    "max_len": 3.0,
    "run_to_end_within": 3.0,
    "count_share": 0.6,
    "count_max": 1.6,
    "number_size_pct": 16,
    "background": "0xF7F7F7",
    "font": "Inter"
  },
  "zoom": {
    "enabled": true,
    "levels": [
      100,
      115
    ],
    "min_hold": 1.2,
    "max_hold": 3.8,
    "change_on_cut": true,
    "skip_hook": false
  },
  "music": {
    "enabled": true,
    "level_db": -18,
    "fade_in": 0.2,
    "fade_out": 0.8
  },
  "deliver": {
    "loudness_lufs": -14
  },
  "caption_variant": "white-bold",
  "caption_variants": {
    "white-bold": {
      "emphasis": "track",
      "_ref": "sample8 / sample9: small white medium + big white bold key phrases (2 tracks)"
    },
    "blue-accent": {
      "emphasis": "word",
      "accent": "#0EB2EE",
      "look": {
        "weight": "SemiBold",
        "size_px_at_1080w": 68,
        "center_y_pct": 61
      },
      "_ref": "sample7: white captions, the key word of key phrases in house blue #0EB2EE"
    },
    "blue-all": {
      "emphasis": "none",
      "look": {
        "color": "#0EB2EE",
        "weight": "Bold",
        "size_px_at_1080w": 78,
        "center_y_pct": 61,
        "shadow": {
          "opacity": 0.6,
          "blur_px": 6,
          "distance_px": 2
        }
      },
      "_ref": "sample10: every caption bold house blue with a dark soft shadow"
    }
  },
  "clips": {
    "min_len": 25,
    "max_len": 60,
    "_note": "length range for `clips` (long recording -> shorts)"
  }
}